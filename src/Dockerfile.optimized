# Use Debian 12 slim as the base image
FROM debian:12-slim

# Set working directory
WORKDIR /app

# Set environment variables for faster package installation
ENV DEBIAN_FRONTEND=noninteractive
ENV APT_KEY_DONT_WARN_ON_DANGEROUS_USAGE=1

# Update package list with timeout and retry
RUN apt-get update -o Acquire::http::Timeout=30 -o Acquire::http::Retries=3 && \
    apt-get install -y --no-install-recommends \
    curl \
    gnupg \
    apt-transport-https \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# Install Python and essential dependencies in one layer
RUN apt-get update -o Acquire::http::Timeout=30 -o Acquire::http::Retries=3 && \
    apt-get install -y --no-install-recommends \
    python3 \
    python3-venv \
    python3-pip \
    python3-dev \
    python3-setuptools \
    python3-wheel \
    && rm -rf /var/lib/apt/lists/*

# Set Python 3 as the default python command
RUN ln -s /usr/bin/python3 /usr/bin/python

# Install build dependencies in one layer
RUN apt-get update -o Acquire::http::Timeout=30 -o Acquire::http::Retries=3 && \
    apt-get install -y --no-install-recommends \
    build-essential \
    libffi-dev \
    libssl-dev \
    libjpeg-dev \
    zlib1g-dev \
    libfreetype6-dev \
    liblcms2-dev \
    libopenjp2-7-dev \
    libtiff5-dev \
    libwebp-dev \
    libharfbuzz-dev \
    libfribidi-dev \
    libxcb1-dev \
    unixodbc \
    unixodbc-dev \
    && rm -rf /var/lib/apt/lists/*

# Install Microsoft ODBC Driver with timeout
RUN curl -sSL --connect-timeout 30 --max-time 60 -O https://packages.microsoft.com/config/debian/$(grep VERSION_ID /etc/os-release | cut -d '"' -f 2 | cut -d '.' -f 1)/packages-microsoft-prod.deb && \
    dpkg -i packages-microsoft-prod.deb && \
    apt-get update -o Acquire::http::Timeout=30 -o Acquire::http::Retries=3 && \
    ACCEPT_EULA=Y apt-get install -y --no-install-recommends msodbcsql17 && \
    rm -f packages-microsoft-prod.deb && \
    rm -rf /var/lib/apt/lists/*

# Create user and group
RUN groupadd -r app && useradd -r -g app -m -d /app -s /bin/bash app

# Create necessary directories and set ownership
RUN mkdir -p /app/src/logs /app/src/static/files && \
    chown -R app:app /app

# Copy requirements first for better caching
COPY --chown=app:app src/requirements.txt .

# Create virtual environment and install Python packages with timeout
USER app
RUN python3 -m venv /app/venv && \
    /app/venv/bin/pip install --upgrade pip setuptools wheel --timeout 300 --retries 3 && \
    /app/venv/bin/pip install --no-cache-dir --timeout 300 --retries 3 -r requirements.txt

# Copy application files
COPY --chown=app:app src/ /app/src/

# Create the startup script
RUN echo '#!/bin/bash' > /app/start.sh && \
    echo 'set -e' >> /app/start.sh && \
    echo 'echo "🚀 Démarrage de l application Datalys Consulting..."' >> /app/start.sh && \
    echo 'cd /app/src' >> /app/start.sh && \
    echo 'export PYTHONPATH=/app/src:$PYTHONPATH' >> /app/start.sh && \
    echo 'export PORT=8082' >> /app/start.sh && \
    echo 'export ENV=production' >> /app/start.sh && \
    echo 'echo "✅ Environnement configuré"' >> /app/start.sh && \
    echo 'echo "🌐 Démarrage sur le port $PORT"' >> /app/start.sh && \
    echo 'exec /app/venv/bin/python run.py' >> /app/start.sh && \
    chmod +x /app/start.sh

# Expose port
EXPOSE 8082

# Health check with timeout
HEALTHCHECK --interval=60s --timeout=30s --start-period=120s --retries=5 \
    CMD curl -f --connect-timeout 10 --max-time 30 http://localhost:8082/health || exit 1

# Default command
CMD ["/app/start.sh"] 