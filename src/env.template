# Base de données MySQL
DB_HOST=localhost
DB_USER=your_username
DB_PASSWORD=your_password
DB_NAME=datalys_consulting

# Configuration Flask
SECRET_KEY=your_secret_key_here
ENV=local
SESSION_EXPIRE_MINUTES=30

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# Timeouts
TIME_OUT=60
DB_CONNECT_TIMEOUT=30
DB_READ_TIMEOUT=60
REDIS_CONNECT_TIMEOUT=30
REDIS_READ_TIMEOUT=60
HTTP_TIMEOUT=30
HTTP_CONNECT_TIMEOUT=10

# Fichiers et uploads
UPLOAD_FOLDER=./static/files
LOG_FILE_PATH=logs/datalys_consulting.log

# Configuration Email (SMTP)
# Options: smtp.hostinger.com (port 465, SSL) ou pro1.mail.ovh.net (port 587, TLS)
MAIL_SERVER=smtp.hostinger.com
MAIL_PORT=465
MAIL_USE_SSL=True
MAIL_USE_TLS=False
MAIL_USERNAME=appweb@datalysconsulting.com
MAIL_PASSWORD=your_email_password
MAIL_DEFAULT_SENDER=appweb@datalysconsulting.com
SENDER_NAME=Datalys Consulting
APP_URL=http://localhost:5000

# JWT Configuration
JWT_SECRET_KEY=your_jwt_secret_key_here

# Configuration Flask URLs
SERVER_NAME=localhost:5000
APPLICATION_ROOT=/
PREFERRED_URL_SCHEME=http

# Firebase Cloud Messaging (FCM) - Notifications Push
FIREBASE_ENABLED=True
# Le fichier firebase-service-account.json doit être présent dans src/config/

# Notifications push automatiques
FCM_AUTO_NOTIFY_HIGH_PRIORITY=True
FCM_AUTO_NOTIFY_CRITICAL_PRIORITY=True
