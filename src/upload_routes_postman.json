{
  "name": "📤 File Upload Routes",
  "item": [
    {
      "name": "Upload Logo",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{auth_token}}"
          }
        ],
        "body": {
          "mode": "formdata",
          "formdata": [
            {
              "key": "file",
              "type": "file",
              "src": []
            }
          ]
        },
        "url": {
          "raw": "{{base_url}}/files/upload/logo",
          "host": ["{{base_url}}"],
          "path": ["files", "upload", "logo"]
        }
      },
      "response": []
    },
    {
      "name": "Upload File",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{auth_token}}"
          }
        ],
        "body": {
          "mode": "formdata",
          "formdata": [
            {
              "key": "file",
              "type": "file",
              "src": []
            },
            {
              "key": "subfolder",
              "value": "files",
              "type": "text"
            }
          ]
        },
        "url": {
          "raw": "{{base_url}}/files/upload",
          "host": ["{{base_url}}"],
          "path": ["files", "upload"]
        }
      },
      "response": []
    },
    {
      "name": "Delete Uploaded File",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{auth_token}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"file_path\": \"uploads/logos/20241201_123456_uuid.jpg\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/files/upload/delete",
          "host": ["{{base_url}}"],
          "path": ["files", "upload", "delete"]
        }
      },
      "response": []
    },
    {
      "name": "Serve File",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/files/serve/logos/20241201_123456_uuid.jpg",
          "host": ["{{base_url}}"],
          "path": ["files", "serve", "logos", "20241201_123456_uuid.jpg"]
        }
      },
      "response": []
    }
  ]
} 