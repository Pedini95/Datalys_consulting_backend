# Configuration de production pour Datalys Consulting Backend
# Copier ce fichier vers .env.production et ajuster les valeurs

# Environnement
ENV=production
FLASK_ENV=production

# Base de données MySQL
DB_HOST=localhost
DB_PORT=3306
DB_NAME=datalys_consulting
DB_USER=datalys_user
DB_PASSWORD=your_secure_password_here

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# Timeouts optimisés pour éviter les timeouts de déploiement
TIME_OUT=60
DB_CONNECT_TIMEOUT=30
DB_READ_TIMEOUT=60
REDIS_CONNECT_TIMEOUT=30
REDIS_READ_TIMEOUT=60
HTTP_TIMEOUT=30
HTTP_CONNECT_TIMEOUT=10

# Configuration Flask
SECRET_KEY=your_very_secure_secret_key_here
PORT=8082
UPLOAD_FOLDER=/app/src/static/files
LOG_FILE_PATH=/app/src/logs/datalys_consulting.log

# Configuration email (SMTP Hostinger - SSL sur port 465)
MAIL_SERVER=smtp.hostinger.com
MAIL_PORT=465
MAIL_USE_SSL=True
MAIL_USE_TLS=False
MAIL_USERNAME=appweb@datalysconsulting.com
MAIL_PASSWORD=your_email_password
MAIL_DEFAULT_SENDER=appweb@datalysconsulting.com
SENDER_NAME=Datalys Consulting

# Configuration application
APP_URL=https://your-domain.com
SERVER_NAME=your-domain.com:8082
APPLICATION_ROOT=/
PREFERRED_URL_SCHEME=https

# Configuration de session
SESSION_EXPIRE_MINUTES=30 